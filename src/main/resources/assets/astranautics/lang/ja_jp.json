  "ponder.astranautics.balloon.title.0": "\u6d6e\u529b\u306e\u3082\u3068",
  "ponder.astranautics.balloon.body.0": "1 \u500b\u3067\u8cea\u91cf 1.5 \u3076\u3093\u3092\u6301\u3061\u4e0a\u3052\u307e\u3059\u3002\u7247\u5074\u306b\u56fa\u3081\u308b\u3068\u91cd\u5fc3\u304b\u3089\u96e2\u308c\u3066\u8239\u304c\u50be\u304d\u307e\u3059\u3002\n\u767d\u30a6\u30fc\u30eb 4 + \u9769\u3067\u30af\u30e9\u30d5\u30c8\u3002",
  "ponder.astranautics.balloon.title.1": "\u9ad8\u5ea6\u3068\u6c34",
  "ponder.astranautics.balloon.body.1": "\u6c17\u5727\u304c\u9ad8\u5ea6\u3068\u3068\u3082\u306b\u4e0b\u304c\u308b\u306e\u3067\u3001\u8239\u306f\u300c\u6d6e\u529b \u00d7 \u6c17\u5727 = \u91cd\u91cf\u300d\u306e\u9ad8\u3055\u3067\u6b62\u307e\u308a\u307e\u3059\u3002\n\u4e2d\u7a7a\u306e\u8239\u306f\u5bc6\u9589\u7a7a\u6c17\u306e\u3076\u3093\u6c34\u306b\u6d6e\u304d\u3001\u4e2d\u3092\u8a70\u3081\u308b\u3068\u6c88\u307f\u307e\u3059\u3002",
  "ponder.astranautics.propeller.title.0": "\u56de\u3057\u65b9",
  "ponder.astranautics.propeller.body.0": "\u7f6e\u3044\u305f\u5411\u304d\u3078\u62bc\u3057\u307e\u3059\u3002\u8239\u4f53\u306b\u4ed8\u3051\u305f\u30d7\u30ed\u30da\u30e9\u306f\u53f3\u30af\u30ea\u30c3\u30af\u3067 ON / OFF\u3002\nON \u306e\u3068\u304d\u306f\u30d6\u30ec\u30fc\u30c9\u304c\u767d\u304f\u5149\u308b\u30e2\u30c7\u30eb\u306b\u5909\u308f\u308a\u307e\u3059\u3002",
  "ponder.astranautics.propeller.title.1": "\u30a8\u30f3\u30b8\u30f3\u3068\u7e4b\u3050",
