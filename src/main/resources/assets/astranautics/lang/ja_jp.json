  "ponder.astranautics.cogwheel.title.1": "\u7d44\u307f\u65b9\u306e\u4f8b",
  "ponder.astranautics.cogwheel.body.1": "\u30a8\u30f3\u30b8\u30f3 \u2192 \u30b7\u30e3\u30d5\u30c8 \u2192 \u6b6f\u8eca \u2192 \u30b7\u30e3\u30d5\u30c8 \u2192 \u30d7\u30ed\u30da\u30e9\u3001\u3067\u6a5f\u4f53\u3092\u597d\u304d\u306a\u5411\u304d\u306b\u66f2\u3052\u3089\u308c\u307e\u3059\u3002",
  "ponder.astranautics.flywheel.title.0": "\u6163\u6027\u3092\u8db3\u3059",
