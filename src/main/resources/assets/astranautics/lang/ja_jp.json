  "ponder.astranautics.shaft.title.1": "\u66f2\u3052\u308b",
  "ponder.astranautics.shaft.body.1": "\u30b7\u30e3\u30d5\u30c8\u3092\u6a2a\u306b\u4e26\u3079\u3066\u3082\u4f1d\u308f\u308a\u307e\u305b\u3093\u3002\n\u5411\u304d\u3092\u5909\u3048\u305f\u3044\u5834\u6240\u306b\u306f\u6b6f\u8eca\u3092\u631f\u307f\u307e\u3059\u3002",
