  "ponder.astranautics.steam_engine.title.0": "\u71c3\u6599\u3068\u30b9\u30ed\u30c3\u30c8\u30eb",
  "ponder.astranautics.steam_engine.body.0": "\u71c3\u6599\uff08\u77f3\u70ad\u30fb\u6728\u70ad\u30fb\u77f3\u70ad\u30d6\u30ed\u30c3\u30af\u30fb\u30d6\u30ec\u30a4\u30ba\u30ed\u30c3\u30c9\uff09\u3092\u6301\u3063\u3066\u53f3\u30af\u30ea\u30c3\u30af\u3067\u88dc\u7d66\u3002\n\u30b9\u30cb\u30fc\u30af\uff0b\u53f3\u30af\u30ea\u30c3\u30af\u3067\u30b9\u30ed\u30c3\u30c8\u30eb 0\u21921\u21922\u21923\u21924\u21920\u3001\u7d20\u624b\u3067\u53f3\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u72b6\u614b\u8868\u793a\u3002",
  "ponder.astranautics.steam_engine.title.1": "\u56de\u8ee2\u306e\u7acb\u3061\u4e0a\u304c\u308a",
