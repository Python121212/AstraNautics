{
  "_comment": "AstraNautics 物性ルール（上から順に評価し、最初に一致したものを採用）",
  "rules": [
    { "match": { "id": "minecraft:slime_block" }, "mass": 1.1, "friction": 0.90, "restitution": 0.85 },
    { "match": { "id": "minecraft:honey_block" }, "mass": 1.2, "friction": 0.98, "restitution": 0.02 },
    { "match": { "tag": "minecraft:ice" }, "mass": 0.9, "friction": 0.02, "restitution": 0.18 },
    { "match": { "id": "minecraft:sponge" }, "mass": 0.5, "friction": 0.85, "buoyant": true },

    { "match": { "tag": "forge:storage_blocks" }, "mass": 2.4, "friction": 0.45, "restitution": 0.12, "drag": 0.008 },
    { "match": { "tag": "forge:ores" }, "mass": 2.1, "friction": 0.80, "restitution": 0.10 },
    { "match": { "tag": "forge:glass" }, "mass": 0.7, "friction": 0.35, "restitution": 0.20 },
    { "match": { "tag": "forge:glass_blocks" }, "mass": 0.7, "friction": 0.35, "restitution": 0.20 },
    { "match": { "tag": "forge:stone" }, "mass": 1.6, "friction": 0.80, "restitution": 0.10 },
    { "match": { "tag": "forge:cobblestone" }, "mass": 1.6, "friction": 0.82, "restitution": 0.10 },
    { "match": { "tag": "forge:logs" }, "mass": 0.6, "friction": 0.65, "restitution": 0.28, "buoyant": true },
    { "match": { "tag": "forge:planks" }, "mass": 0.6, "friction": 0.65, "restitution": 0.28, "buoyant": true },
    { "match": { "tag": "forge:wool" }, "mass": 0.35, "friction": 0.95, "restitution": 0.02, "buoyant": true },
    { "match": { "tag": "forge:sand" }, "mass": 0.9, "friction": 0.85, "restitution": 0.12 },
    { "match": { "tag": "forge:gravel" }, "mass": 0.9, "friction": 0.85, "restitution": 0.12 },
    { "match": { "tag": "forge:dirt" }, "mass": 0.9, "friction": 0.80, "restitution": 0.15 },
    { "match": { "tag": "forge:chests" }, "mass": 0.8, "friction": 0.70, "buoyant": true }
  ]
}
